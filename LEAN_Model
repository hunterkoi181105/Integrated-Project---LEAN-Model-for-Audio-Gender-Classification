ation":0.010632,"end_time":"2025-12-11T09:11:00.162872","exception":false,"start_time":"2025-12-11T09:11:00.15224","status":"completed"},"tags":[]},"outputs":[],"source":["def compute_dprime(y_true, y_prob):\n","    y_pred = (y_prob >= 0.5).astype(int)\n","\n","    TP = ((y_pred == 1) & (y_true == 1)).sum()\n","    FP = ((y_pred == 1) & (y_true == 0)).sum()\n","    FN = ((y_pred == 0) & (y_true == 1)).sum()\n","    TN = ((y_pred == 0) & (y_true == 0)).sum()\n","\n","    TPR = TP / (TP + FN + 1e-6)\n","    FPR = FP / (FP + TN + 1e-6)\n","\n","    TPR = np.clip(TPR, 1e-6, 1 - 1e-6)\n","    FPR = np.clip(FPR, 1e-6, 1 - 1e-6)\n","\n","    dprime = norm.ppf(TPR) - norm.ppf(FPR)\n","    return float(dprime)"]},{"cell_type":"code","execution_count":15,"id":"b6533f7e","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:11:00.171764Z","iopub.status.busy":"2025-12-11T09:11:00.171556Z","iopub.status.idle":"2025-12-11T09:11:00.184586Z","shell.execute_reply":"2025-12-11T09:11:00.184074Z"},"papermill":{"duration":0.018923,"end_time":"2025-12-11T09:11:00.185623","exception":false,"start_time":"2025-12-11T09:11:00.1667","status":"completed"},"tags":[]},"outputs":[],"source":["def validate_joint(model, val_loader, criterion, device):\n","    model.eval()\n","    total_val_loss = 0\n","\n","    y_true = []\n","    y_prob = []\n","\n","    with torch.no_grad():\n","        for wav, logmel, label in val_loader:\n","            wav = wav.to(device)\n","            logmel = logmel.to(device)\n","            label = label.to(device).float().unsqueeze(1)\n","\n","            logits = model(wav, logmel)\n","            loss = criterion(logits, label)\n","\n","            total_val_loss += loss.item() * label.size(0)\n","\n","            prob = torch.sigmoid(logits).detach().cpu().numpy().flatten()\n","            y_prob.extend(prob)\n","            y_true.extend(label.cpu().numpy().astype(int).flatten())\n","\n","    y_true = np.array(y_true)\n","    y_prob = np.array(y_prob)\n","    y_pred = (y_prob >= 0.5).astype(int)\n","\n","    avg_loss = total_val_loss / len(val_loader.dataset)\n","    val_acc = accuracy_score(y_true, y_pred)\n","\n","    val_auc = roc_auc_score(y_true, y_prob)\n","    val_map = average_precision_score(y_true, y_prob)\n","    val_dprime = compute_dprime(y_true, y_prob)\n","\n","    return avg_loss, val_acc, val_auc, val_map, val_dprime\n","    \n","def train_joint_model(\n","    model, train_loader, val_loader, device,\n","    num_epochs=10, lr=1e-4,weight_decay=1e-2, patience=3,\n","    checkpoint_dir=\"/kaggle/working/checkpoints\",\n","    model_name=\"joint_model\"\n","):\n","\n","    os.makedirs(checkpoint_dir, exist_ok=True)\n","    ckpt_path = os.path.join(checkpoint_dir, f\"{model_name}.pth\")\n","\n","    model = model.to(device)\n","    criterion = nn.BCEWithLogitsLoss()\n","    optimizer = torch.optim.Adam(model.parameters(), lr=lr,weight_decay=weight_decay)\n","\n","    best_model_wts = copy.deepcopy(model.state_dict())\n","    best_acc = 0.0\n","    epochs_no_improve = 0\n","    start_epoch = 0\n","\n","    # ---- metric tracking ----\n","    train_losses, val_losses = [], []\n","    train_accs, val_accs = [], []\n","    train_aucs, val_aucs = [], []\n","    train_maps, val_maps = [], []\n","    train_dprimes, val_dprimes = [], []\n","\n","    progress = tqdm(range(start_epoch, num_epochs), desc=\"Training\")\n","\n","    for epoch in progress:\n","        model.train()\n","        total_train_loss = 0\n","\n","        y_true = []\n","        y_prob = []\n","\n","        for wav, logmel, label in train_loader:\n","            wav = wav.to(device)\n","            logmel = logmel.to(device)\n","            label = label.to(device).float().unsqueeze(1)\n","\n","            optimizer.zero_grad()\n","\n","            logits = model(wav, logmel)\n","            loss = criterion(logits, label)\n","\n","            loss.backward()\n","            optimizer.step()\n","\n","            total_train_loss += loss.item() * label.size(0)\n","\n","            prob = torch.sigmoid(logits).detach().cpu().numpy().flatten()\n","            y_prob.extend(prob)\n","            y_true.extend(label.cpu().numpy().flatten())\n","\n","        # ---- compute train metrics ----\n","        y_true_np = np.array(y_true)\n","        y_prob_np = np.array(y_prob)\n","        y_pred_np = (y_prob_np >= 0.5).astype(int)\n","\n","        avg_train_loss = total_train_loss / len(train_loader.dataset)\n","        train_acc = accuracy_score(y_true_np, y_pred_np)\n","\n","        train_auc = roc_auc_score(y_true_np, y_prob_np)\n","        train_map = average_precision_score(y_true_np, y_prob_np)\n","        train_dprime = compute_dprime(y_true_np, y_prob_np)\n","\n","        # Save train metrics\n","        train_losses.append(avg_train_loss)\n","        train_accs.append(train_acc)\n","        train_aucs.append(train_auc)\n","        train_maps.append(train_map)\n","        train_dprimes.append(train_dprime)\n","\n","        # ---- VALIDATION ----\n","        avg_val_loss, val_acc, val_auc, val_map, val_dprime = validate_joint(\n","            model, val_loader, criterion, device\n","        )\n","\n","        val_losses.append(avg_val_loss)\n","        val_accs.append(val_acc)\n","        val_aucs.append(val_auc)\n","        val_maps.append(val_map)\n","        val_dprimes.append(val_dprime)\n","\n","        progress.set_postfix({\n","            \"TrainLoss\": f\"{avg_train_loss:.4f}\",\n","            \"ValLoss\": f\"{avg_val_loss:.4f}\",\n","            \"Acc\": f\"{val_acc:.4f}\",\n","            \"AUC\": f\"{val_auc:.4f}\",\n","            \"mAP\": f\"{val_map:.4f}\",\n","            \"d'\": f\"{val_dprime:.3f}\"\n","        })\n","\n","        # ---- early stopping ----\n","        if val_acc > best_acc:\n","            best_acc = val_acc\n","            best_model_wts = copy.deepcopy(model.state_dict())\n","            epochs_no_improve = 0\n","            torch.save(best_model_wts, ckpt_path)\n","  