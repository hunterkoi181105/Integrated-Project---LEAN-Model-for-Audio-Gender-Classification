ndswith(\".wav\")]\n","\n","df = pd.DataFrame({\n","    \"path\": male_wavs + female_wavs,\n","    \"label\": [0]*len(male_wavs) + [1]*len(female_wavs)\n","})\n","df.to_csv(\"metadata.csv\",index=False)\n","df.head(5)"]},{"cell_type":"code","execution_count":7,"id":"4e849166","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.555386Z","iopub.status.busy":"2025-12-11T09:10:59.554959Z","iopub.status.idle":"2025-12-11T09:10:59.577816Z","shell.execute_reply":"2025-12-11T09:10:59.576896Z"},"papermill":{"duration":0.029341,"end_time":"2025-12-11T09:10:59.579039","exception":false,"start_time":"2025-12-11T09:10:59.549698","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train: 8075 | Val: 1730 | Test: 1731\n"]}],"source":["train_df, temp_df = train_test_split(df,test_size=0.3,stratify=df['label'],random_state=36)\n","val_df, test_df = train_test_split(temp_df, test_size=0.5, stratify=temp_df[\"label\"], random_state=36)\n","\n","print(\"Train:\", len(train_df), \"| Val:\", len(val_df), \"| Test:\", len(test_df))"]},{"cell_type":"code","execution_count":8,"id":"c3e24158","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.588693Z","iopub.status.busy":"2025-12-11T09:10:59.588464Z","iopub.status.idle":"2025-12-11T09:10:59.592643Z","shell.execute_reply":"2025-12-11T09:10:59.591825Z"},"papermill":{"duration":0.010372,"end_time":"2025-12-11T09:10:59.593904","exception":false,"start_time":"2025-12-11T09:10:59.583532","status":"completed"},"tags":[]},"outputs":[],"source":["N_MELS = 64\n","FRAMES = 96\n","SR = 16000\n","WINDOW_LENGTH = 400 #samples (25ms)\n","HOP_LENGTH = 160    #samples (10ms)\n","SEGMENT_SAMPLES = 16000 #1s\n","FMIN = 125\n","FMAX = 7500"]},{"cell_type":"markdown","id":"fdf072ce","metadata":{"papermill":{"duration":0.004227,"end_time":"2025-12-11T09:10:59.602538","exception":false,"start_time":"2025-12-11T09:10:59.598311","status":"completed"},"tags":[]},"source":["### AUGMENTATION: ADD NOISE TO THE DATA"]},{"cell_type":"code","execution_count":9,"id":"ec0b9bd8","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.611981Z","iopub.status.busy":"2025-12-11T09:10:59.611753Z","iopub.status.idle":"2025-12-11T09:10:59.616847Z","shell.execute_reply":"2025-12-11T09:10:59.616097Z"},"papermill":{"duration":0.011305,"end_time":"2025-12-11T09:10:59.61811","exception":false,"start_time":"2025-12-11T09:10:59.606805","status":"completed"},"tags":[]},"outputs":[],"source":["def random_gain(wav):\n","    gain = random.uniform(0.8,1.2)\n","    return wav*gain\n","\n","def add_noise(wav):\n","    noise_level = random.uniform(0.001,0.015)\n","    noise = np.random.randn(len(wav))*noise_level\n","    return wav + noise\n","\n","def spec_augmentation(logmel):\n","    logmel = logmel.copy()\n","    f = random.randint(0,10)\n","    f0 = random.randint(0,N_MELS - f)\n","    logmel[f0:f0 + f,:] = 0\n","\n","    t = random.randint(0,8)\n","    t0 = random.randint(0,FRAMES - t)\n","    logmel[: ,t0:t0 + t] = 0\n","\n","    return logmel"]},{"cell_type":"code","execution_count":10,"id":"773c8978","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.627976Z","iopub.status.busy":"2025-12-11T09:10:59.627732Z","iopub.status.idle":"2025-12-11T09:10:59.638396Z","shell.execute_reply":"2025-12-11T09:10:59.637739Z"},"papermill":{"duration":0.016886,"end_time":"2025-12-11T09:10:59.639434","exception":false,"start_time":"2025-12-11T09:10:59.622548","status":"completed"},"tags":[]},"outputs":[],"source":["NUM_WORKERS = 4\n","PIN_MEMORY = True\n","\n","class GenderClassificationDataset(Dataset):\n","    def __init__(self,df,augment=False):\n","        self.df = df.reset_index(drop=True)\n","        self.augment = augment\n","        \n","    def __len__(self):\n","        return len(self.df)\n","        \n","    def __getitem__(self,idx):\n","        path = self.df.iloc[idx][\"path\"]\n","        label = float(self.df.iloc[idx][\"label\"])\n","\n","        wav,_ = librosa.load(path,sr=SR)\n","        if len(wav) <= SEGMENT_SAMPLES:\n","            pad = SEGMENT_SAMPLES - len(wav)\n","            wav = np.pad(wav,(0,pad))\n","        else:\n","            start = random.randint(0,len(wav) - SEGMENT_SAMPLES)\n","            wav = wav[start:start + SEGMENT_SAMPLES]\n","\n","        if self.augment:\n","            wav = random_gain(wav)\n","            wav = add_noise(wav)\n","\n","        wav = wav/(np.max(np.abs(wav)) + 1e-6)\n","\n","        mel = librosa.feature.melspectrogram(\n","            y=wav,\n","            sr=SR,\n","            n_fft=WINDOW_LENGTH,\n","            hop_length=HOP_LENGTH,\n","            n_mels=N_MELS,\n","            fmin=FMIN,\n","            fmax=FMAX,\n","            power=2.0\n","        )\n","        logmel = librosa.power_to_db(mel,ref=np.max)\n","\n","        if logmel.shape[1] < FRAMES:\n","            pad = np.zeros((N_MELS,FRAMES - logmel.shape[1]))\n","            logmel = np.hstack([logmel,pad])\n","        elif logmel.shape[1] > FRAMES:\n","            logmel = logmel[:,:FRAMES]\n","\n","        if self.augment:\n","            logmel = spec_augmentation(logmel)\n","\n","        wav_tensor = torch.tensor(wav, dtype=torch.float32)\n","        logmel_tensor = torch.tensor(logmel, dtype=torch.float32)\n","        labels = torch.tensor(label, dtype=torch.float32)\n","\n","        return wav_tensor, logmel_tensor, labels\n","            \n","            \n","\n","train_ds = GenderClassificationDataset(train_df,augment=True)\n","test_ds = GenderClassificationDataset(test_df,augment=False)\n","val_ds = GenderClassificationDataset(val_df,augment=False)\n","\n","train_loader = DataLoader(train_ds, batch_size=16, shuffle=True,\n","                          num_workers=NUM_WORKERS,pin_memory=PIN_MEMORY)\n","val_loader   = DataLoader(val_ds, batch_size=16, shuffle=False,\n","                          num_workers=NUM_WORKERS,pin_memory=PIN_MEMORY)\n","test_loader  = DataLoader(test_ds, batch_size=16, shuffle=False,\n","                          num_workers=NUM_WORKERS,pin_memory=PIN_MEMORY)"]},{"cell_type":"markdown","id":"5d21797d","metadata":{"papermill":{"duration":0.004206,"end_time":"2025-12-11T09:10:59.647987","exception":false,"start_time":"2025-12-11T09:10:59.643781","status":"completed"},"tags":[]},"source":["### MODEL BACKBONE: Light and Efficient Audio Classification Network\n"]},{"cell_type":"code","execution_count":11,"id":"2907996b","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.659012Z","iopub.status.busy":"2025-12-11T09:10:59.658413Z","iopub.status.idle":"2025-12-11T09:10:59.743402Z","shell.execute_reply":"2025-12-11T09:10:59.742796Z"},"papermill":{"duration":0.091619,"end_time":"2025-12-11T09:10:59.744534","exception":false,"start_time":"2025-12-11T09:10:59.652915","status":"completed"},"tags":[]},"outputs":[],"source":["SEGMENT_SAMPLES = 15600\n","N_MELS = 64\n","YAMNET_OUT_DIM = 1024\n","PROJ_DIM = 256\n","LSTM_HID = 128\n","LSTM_DIRECTIONS = 2\n","LSTM_OUT_DIM = LSTM_HID*LSTM_DIRECTIONS #256 dim\n","NUM_CLASSES = 1\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")"]},{"cell_type":"code","execution_count":12,"id":"511704ff","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.753481Z","iopub.status.busy":"2025-12-11T09:10:59.753245Z","iopub.status.idle":"2025-12-11T09:10:59.767987Z","shell.execute_reply":"2025-12-11T09:10:59.767421Z"},"papermill":{"duration":0.020391,"end_time":"2025-12-11T09:10:59.768979","exception":false,"start_time":"2025-12-11T09:10:59.748588","status":"completed"},"tags":[]},"outputs":[],"source":["class YamnetBackbone(nn.Module):\n","    def __init__(self,n_mels=N_MELS,out_dim=YAMNET_OUT_DIM):\n","        super().__init__()\n","        def block(c_in, c_out):\n","            return nn.Sequential(\n","                    nn.Conv2d(c_in, c_out, 3, padding=1),\n","                    nn.BatchNorm2d(c_out),\n","                    nn.ReLU(),\n","                    nn.Conv2d(c_out, c_out, 3, padding=1),\n","                    nn.BatchNorm2d(c_out),\n","                    nn.ReLU())\n","    \n","        self.features = nn.Sequential(\n","            # ---- Block 1 (2 layers)\n","            block(1, 32),\n","            nn.MaxPool2d(2,2),\n","    \n","            # ---- Block 2 (2 layers)\n","            block(32, 64),\n","            nn.MaxPool2d(2,2),\n","    \n","            # ---- Block 3 (2 layers)\n","            block(64, 128),\n","            nn.MaxPool2d(2,2),\n","    \n","            # ---- Block 4 (2 layers)\n","            block(128, 256),\n","            nn.MaxPool2d(2,2),\n","    \n","            # ---- Block 5 (2 layers)\n","            block(256, 512),\n","            nn.AdaptiveAvgPool2d((1,1))\n","        )\n","    \n","        self.fc = nn.Linear(512, out_dim)\n","\n","    def forward(self, logmel):\n","        x = logmel.unsqueeze(1)       # (B,1,n_mels,frames)\n","        x = self.features(x)          # (B, 512, 1, 1)\n","        x = x.view(x.size(0), -1)     # (B, 512)\n","        x = self.fc(x)                # (B, out_dim)\n","        return x\n","\n","class YamnetProjection(nn.Module): ##DENSE LAYER\n","    def __init__(self,in_dim=YAMNET_OUT_DIM,proj_dim=PROJ_DIM):\n","        super().__init__()\n","        self.proj = nn.Sequential(\n","            nn.Linear(in_dim,proj_dim),\n","            nn.ReLU(),\n","            nn.LayerNorm(proj_dim)\n","        )\n","    def forward(self,eyam):\n","        return self.proj(eyam) #(B, PROJ_DIM)\n","\n","\n","class WaveEncoder(nn.Module):\n","    def __init__(self,input_dim=1,lstm_hidden=LSTM_HID,num_layers=2,bidirectional=True):\n","        super().__init__()\n","        self.lstm = nn.LSTM(input_size=input_dim,\n","                            hidden_size=lstm_hidden,\n","                            num_layers=num_layers,\n","                            batch_first=True,\n","                            bidirectional=bidirectional,\n","                            dropout=0.1)\n","    def forward(self,wav):\n","        #waveform in tensor float type (B,T)\n","        B, T = wav.shape\n","        x = wav.unsqueeze(-1) #(B,T,-1)\n","        out,_ = self.lstm(x) #Output: (B,T,hidden*directions)\n","        return out #(B,T,LSTM_OUT_DIM)\n","\n","\n","class ConditionalAttention(nn.Module):\n","    def __init__(self,in_dim,out_dim):\n","        super().__init__()\n","    def forward(self,Eyam,h_seq):\n","        # Eyam: (B,D)\n","        # h_seq: (B,T,D)\n","        # dot production dot(Eyam,h_t): (B,T)\n","        # elementwise multiply then sum over D\n","        # Eyam -> (B,1,D)\n","    \n","        Ey = Eyam.unsqueeze(1) #(B,1,D)\n","        dot = torch.sum(Ey*h_seq,dim=-1) #(B,T)\n","        scores = torch.tanh(dot)\n","        weights = F.softmax(scores,dim=-1)\n","        context = (weights.unsqueeze(-1)*h_seq).sum(dim=1) #(B,D)\n","        return context,weights #context: (B,D) || weights: (B,T)\n","\n","class ClassifierHead(nn.Module):\n","    def __init__(self,in_dim=PROJ_DIM*2,num_classes=NUM_CLASSES,hidden=256,dropout=0.3):\n","        super().__init__()\n","        self.model = nn.Sequential(\n","                nn.Linear(in_dim, hidden),\n","                nn.ReLU(),\n","                nn.Dropout(dropout),\n","                nn.Linear(hidden, num_classes)\n","            )\n","\n","    def forward(self,x):\n","        logits = self.model(x)\n","        return logits\n","\n","class JointModel(nn.Module):\n","    def __init__(self,lstm_hidden=LSTM_HID,\n","               yamnet_out_dim=YAMNET_OUT_DIM,\n","               proj_dim=PROJ_DIM,\n","               n_mels=N_MELS,\n","               num_classes=NUM_CLASSES):\n","        super().__init__()\n","        self.wave_encoder = WaveEncoder(input_dim=1,\n","                                    lstm_hidden=lstm_hidden,\n","                                    num_layers=2,\n","                                    bidirectional=True)\n","        self.yamnet_backbone = YamnetBackbone(n_mels=n_mels,out_dim=yamnet_out_dim)\n","        self.yamnet_projection = YamnetProjection(in_dim=yamnet_out_dim,proj_dim=proj_dim)\n","\n","        self.h_proj = nn.Sequential(\n","                    nn.Linear(lstm_hidden*2,proj_dim),\n","                    nn.ReLU(),\n","                    nn.LayerNorm(proj_dim)\n","                  )\n","\n","        self.attention = ConditionalAttention(yamnet_out_dim,lstm_hidden)\n","        self.classifier = ClassifierHead(in_dim=proj_dim*2,hidden=256,num_classes=num_classes)\n","\n","    def forward(self,wav,logmel):\n","      \n","        h_seq = self.wave_encoder(wav)\n","        h_seq_proj = self.h_proj(h_seq)\n","    \n","        eyam = self.yamnet_backbone(logmel)\n","        eyam_proj = self.yamnet_projection(eyam)\n","    \n","        context,weights = self.attention(eyam_proj,h_seq_proj)\n","    \n","        joint = torch.cat([context,eyam_proj],dim=1)\n","    \n","        logits = self.classifier(joint)\n","    \n","        return logits\n"]},{"cell_type":"code","execution_count":13,"id":"23cd1642","metadata":{"execution":{"iopub.execute_input":"2025-12-11T09:10:59.777567Z","iopub.status.busy":"2025-12-11T09:10:59.777319Z","iopub.status.idle":"2025-12-11T09:11:00.139006Z","shell.execute_reply":"2025-12-11T09:11:00.137976Z"},"papermill":{"duration":0.367442,"end_time":"2025-12-11T09:11:00.140215","exception":false,"start_time":"2025-12-11T09:10:59.772773","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["wave_encoder.lstm.weight_ih_l0           512\n","wave_encoder.lstm.weight_hh_l0           65536\n","wave_encoder.lstm.bias_ih_l0             512\n","wave_encoder.lstm.bias_hh_l0             512\n","wave_encoder.lstm.weight_ih_l0_reverse   512\n","wave_encoder.lstm.weight_hh_l0_reverse   65536\n","wave_encoder.lstm.bias_ih_l0_reverse     512\n","wave_encoder.lstm.bias_hh_l0_reverse     512\n","wave_encoder.lstm.weight_ih_l1           131072\